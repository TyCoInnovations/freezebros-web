{
  "name": "freezebros-web",
  "version": "0.1.0",
  "private": true,
  "description": "Freeze Bros online store - freeze dried fruit and lollies. Built with Next.js, ready for Stripe Checkout.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
