# Copy this file to .env.local for local development, and add the same
# variables in your hosting provider's settings (e.g. Vercel > Settings >
# Environment Variables) for production.

# The public address of the store, used for SEO tags, the sitemap and
# Stripe's return links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe ----------------------------------------------------------
# Leave these empty to run the store in demo mode (no payments taken).
# Find your keys at https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint /api/webhooks/stripe
# (starts with whsec_). Create the endpoint at
# https://dashboard.stripe.com/webhooks, or run `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
